{
	"tasks": {
		"build": "deno run --allow-read=. --allow-write=build --allow-env=SASS_PATH --allow-net --allow-run build.ts",
		"serve": "deno run --allow-read=. --allow-write=build --allow-env=SASS_PATH --allow-net --allow-run build.ts --serve --port 8081",
		"dev": "deno run --unsafe-proto --allow-read=. --allow-write=build --allow-env=SASS_PATH --allow-net --allow-run build.ts --serve --port 9091 --debug",
		"clean": "rm -r build"
	},
	"imports": {
		"@olli/async-lock": "jsr:@olli/async-lock@^1.0.2",
		"@std/async": "jsr:@std/async@^1.5.0",
		"@std/cli": "jsr:@std/cli@^1.0.32",
		"@std/datetime": "jsr:@std/datetime@^0.225.7",
		"@std/fmt": "jsr:@std/fmt@^1.0.10",
		"@std/fs": "jsr:@std/fs@^1.0.24",
		"@std/http": "jsr:@std/http@^1.1.3",
		"@std/path": "jsr:@std/path@^1.1.6",
		"@lambdaurora/libhtml": "jsr:@lambdaurora/libhtml@^1.3.2",
		"@lambdaurora/libmd": "jsr:@lambdaurora/libmd@^2.3.1",
		"@prism.js": "npm:prismjs@^1.30.0",
		"@katex/": "https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/",
		"@core/asyncutil/": "jsr:/@core/asyncutil@^1.2.0/",
		"sass": "npm:sass@^1.97.2"
	},
	"fmt": {
		"useTabs": true,
		"lineWidth": 160,
		"exclude": [
			"**/*.md"
		]
	},
	"lock": false
}
